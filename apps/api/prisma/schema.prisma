// NESTO data model. Spec: Lets start - md files/architecture.md §6 and categories.md.
// Phase 1 holds the catalog only; customers, orders, payments etc. are added in the phase that uses them.
//
// Conventions (CLAUDE.md §4.3):
//   - identifiers, codes and enum values are English; everything a customer reads has a Hebrew field (*He)
//   - money is stored in agorot (integer), prices include VAT
//   - dimensions are numbers in cm, never text

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Delivery mode of a variant (PRD-09, ADM-12).
enum FulfillmentMode {
  IN_STOCK      @map("in_stock")
  PRE_ORDER     @map("pre_order")
  MADE_TO_ORDER @map("made_to_order")
  OUT_OF_STOCK  @map("out_of_stock")

  @@map("fulfillment_mode")
}

/// Where an attribute value is chosen: once per product (style) or per variant (color, fabric).
enum AttributeScope {
  PRODUCT @map("product")
  VARIANT @map("variant")

  @@map("attribute_scope")
}

/// White-background cut-out or lifestyle ("atmosphere") photo (PRD-01).
enum ImageKind {
  CUTOUT    @map("cutout")
  LIFESTYLE @map("lifestyle")

  @@map("image_kind")
}

/// Furniture-type tree (sofas → corner sofas). A product belongs to exactly one category.
model Category {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  nameHe    String  @map("name_he")
  parentId  Int?    @map("parent_id")
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  parent       Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]          @relation("CategoryTree")
  products     Product[]
  attributes   CategoryAttribute[]
  /// Shipping rate of a top-level category (Phase 4b).
  shippingRate ShippingRate?

  @@index([parentId])
  @@map("categories")
}

/// Room for the main menu (decision 44). A product can appear in many rooms.
model Room {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  nameHe    String  @map("name_he")
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  products ProductRoom[]

  @@map("rooms")
}

model Product {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  /// English model name, required and unique (decision 46), e.g. ALBA.
  modelName        String   @unique @map("model_name")
  nameHe           String   @map("name_he")
  descriptionHe    String   @default("") @map("description_he")
  categoryId       Int      @map("category_id")
  countryOfOrigin  String?  @map("country_of_origin")
  warrantyMonths   Int?     @map("warranty_months")
  careHe           String?  @map("care_he")
  requiresAssembly Boolean  @default(false) @map("requires_assembly")
  active           Boolean  @default(true)
  /// Fill the "goes with" / "similar" rows with automatic results after the manual picks (decision 67).
  goesWithAutofill Boolean  @default(true) @map("goes_with_autofill")
  similarAutofill  Boolean  @default(true) @map("similar_autofill")
  /// "Recommended" sort: lower first.
  sortOrder        Int      @default(0) @map("sort_order")
  /// "Best sellers" sort: higher first. Updated from orders in a later phase.
  popularity       Int      @default(0)
  /// Denormalized text for search (decision 47): model name, SKUs, Hebrew name, description,
  /// category and attribute labels. Rebuilt whenever the product changes; trigram-indexed.
  searchText       String   @default("") @map("search_text")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rooms           ProductRoom[]
  variants        Variant[]
  images          Image[]
  attributeValues ProductAttributeValue[]
  relations       ProductRelation[]       @relation("relationsFrom")
  relatedTo       ProductRelation[]       @relation("relationsTo")

  @@index([categoryId])
  /// Trigram index for fuzzy search (decision 47). Declared here so migrations keep it.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

model ProductRoom {
  productId Int @map("product_id")
  roomId    Int @map("room_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([productId, roomId])
  @@index([roomId])
  @@map("product_rooms")
}

/// One purchasable combination (color × fabric × chaise side × size). Dimensions live here because
/// size variants differ in width (categories.md §6).
/// Kind of a manual related-product pick (decision 67).
enum RelationKind {
  goes_with
  similar

  @@map("relation_kind")
}

/// A manual "goes with" / "similar" pick (decision 67). Every link is stored both ways, as two rows;
/// `position` orders the picks on the `productId` side.
model ProductRelation {
  productId Int          @map("product_id")
  relatedId Int          @map("related_id")
  kind      RelationKind
  position  Int

  product Product @relation("relationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("relationsTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId, kind])
  @@index([relatedId])
  @@map("product_relations")
}

model Variant {
  id             Int             @id @default(autoincrement())
  productId      Int             @map("product_id")
  sku            String          @unique
  /// Agorot, VAT included.
  price          Int
  /// Price before discount, agorot. Null = not on sale.
  compareAtPrice Int?            @map("compare_at_price")
  stock          Int             @default(0)
  fulfillment    FulfillmentMode @default(IN_STOCK)
  /// Maximum delivery time in business days (PRD-09).
  leadTimeDays   Int             @map("lead_time_days")
  /// Business days of manufacturing, for MADE_TO_ORDER.
  productionDays Int?            @map("production_days")
  /// Expected arrival, for PRE_ORDER.
  expectedAt     DateTime?       @map("expected_at") @db.Date
  sortOrder      Int             @default(0) @map("sort_order")
  active         Boolean         @default(true)

  widthCm       Decimal  @map("width_cm") @db.Decimal(6, 1)
  depthCm       Decimal  @map("depth_cm") @db.Decimal(6, 1)
  heightCm      Decimal  @map("height_cm") @db.Decimal(6, 1)
  weightKg      Decimal? @map("weight_kg") @db.Decimal(6, 1)
  /// Sofa and armchair fields (categories.md §5.1) — needed by the future room-fit feature.
  seatHeightCm  Decimal? @map("seat_height_cm") @db.Decimal(6, 1)
  seatDepthCm   Decimal? @map("seat_depth_cm") @db.Decimal(6, 1)
  chaiseWidthCm Decimal? @map("chaise_width_cm") @db.Decimal(6, 1)
  chaiseDepthCm Decimal? @map("chaise_depth_cm") @db.Decimal(6, 1)

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([productId])
  @@map("variants")
}

/// Closed-list attribute (ADM-03): color, fabric, style... Values are English codes with Hebrew labels.
model Attribute {
  id         Int            @id @default(autoincrement())
  code       String         @unique
  nameHe     String         @map("name_he")
  scope      AttributeScope
  filterable Boolean        @default(true)
  sortOrder  Int            @default(0) @map("sort_order")

  values     AttributeValue[]
  categories CategoryAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id          Int     @id @default(autoincrement())
  attributeId Int     @map("attribute_id")
  code        String
  labelHe     String  @map("label_he")
  /// Swatch color for color values.
  swatchHex   String? @map("swatch_hex")
  sortOrder   Int     @default(0) @map("sort_order")

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products  ProductAttributeValue[]
  variants  VariantAttributeValue[]
  images    Image[]

  @@unique([attributeId, code])
  @@map("attribute_values")
}

/// Which attributes a category uses for filters and variant options (categories.md §5).
model CategoryAttribute {
  categoryId  Int @map("category_id")
  attributeId Int @map("attribute_id")
  sortOrder   Int @default(0) @map("sort_order")

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@map("category_attributes")
}

model ProductAttributeValue {
  productId        Int @map("product_id")
  attributeValueId Int @map("attribute_value_id")

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([productId, attributeValueId])
  @@map("product_attribute_values")
}

model VariantAttributeValue {
  variantId        Int @map("variant_id")
  attributeValueId Int @map("attribute_value_id")

  variant        Variant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

/// Product photo (Phase 2d, decision 62). Linked to a color, not to a variant: one set of photos
/// serves every size and fabric of that color. Uploaded photos are stored as resized WebP/AVIF
/// copies under `storageKey`; the untouched original is kept privately for re-processing.
model Image {
  id           Int       @id @default(autoincrement())
  productId    Int       @map("product_id")
  /// A value of the `color` attribute. Null = shown for every color.
  colorValueId Int?      @map("color_value_id")
  /// Public URL of the default size (or a static placeholder for seeded dev images).
  url          String
  /// Storage key of uploaded photos: `products/<id>/<random>`. Null for static placeholders.
  storageKey   String?   @map("storage_key")
  /// Widths generated for srcset, ascending.
  widths       Int[]     @default([])
  width        Int?
  height       Int?
  altHe        String    @map("alt_he")
  kind         ImageKind @default(CUTOUT)
  /// Lower first; the first photo is the product's main photo in lists.
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorValue AttributeValue? @relation(fields: [colorValueId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("images")
}

/// Admin-managed search synonyms (decision 47), e.g. ספה ↔ sofa, כורסה ↔ כורסא.
/// Every term in a group is treated as equivalent to the others.
model SearchSynonym {
  id    Int      @id @default(autoincrement())
  terms String[]

  @@map("search_synonyms")
}

// ---------------------------------------------------------------------------
// Admin users, permissions and login (Phase 2a, decisions 48–54, 59)
// ---------------------------------------------------------------------------

enum AdminUserStatus {
  /// Created by the Super Admin; has not set a password yet.
  INVITED  @map("invited")
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("admin_user_status")
}

enum AdminTokenType {
  INVITE         @map("invite")
  PASSWORD_RESET @map("password_reset")

  @@map("admin_token_type")
}

model AdminUser {
  id                 Int             @id @default(autoincrement())
  /// Stored lower-case.
  email              String          @unique
  name               String
  /// Exactly one user is the Super Admin (decision 48), enforced by a partial unique index.
  isSuperAdmin       Boolean         @default(false) @map("is_super_admin")
  status             AdminUserStatus @default(INVITED)
  /// argon2id hash; null until the user accepts the invite. Nobody ever sees the password (decision 59).
  passwordHash       String?         @map("password_hash")
  /// Permission template code (decision 49), e.g. "manager". Ignored for the Super Admin.
  template           String?
  /// Single permissions added on top of the template.
  extraPermissions   String[]        @default([]) @map("extra_permissions")
  /// Single permissions removed from the template.
  removedPermissions String[]        @default([]) @map("removed_permissions")
  /// TOTP secret, AES-256-GCM encrypted with TOTP_ENCRYPTION_KEY. Set during setup, trusted once enabled.
  totpSecretEnc      String?         @map("totp_secret_enc")
  totpEnabledAt      DateTime?       @map("totp_enabled_at")
  /// Progressive delay after failed logins (decision 59): no hard lock-out.
  failedLogins       Int             @default(0) @map("failed_logins")
  loginBlockedUntil  DateTime?       @map("login_blocked_until")
  lastLoginAt        DateTime?       @map("last_login_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  sessions      AdminSession[]
  tokens        AdminToken[]
  recoveryCodes AdminRecoveryCode[]
  auditEntries  AuditLog[]

  @@map("admin_users")
}

/// Server-side session; the cookie holds a random token and only its SHA-256 is stored.
model AdminSession {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  /// False between password and 2FA; such a session can only finish 2FA.
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  /// "Remember this device": no idle timeout, the session lasts up to 30 days (decision 53).
  trusted     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  ip          String?
  userAgent   String?   @map("user_agent")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

/// One-time links: invite (decision 52) and password reset (decision 59). Only the SHA-256 is stored.
model AdminToken {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  type      AdminTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_tokens")
}

/// 10 single-use recovery codes per user (decision 51), argon2-hashed.
model AdminRecoveryCode {
  id       Int       @id @default(autoincrement())
  userId   Int       @map("user_id")
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_recovery_codes")
}

/// Who changed what, when, before and after (decision 54). Kept two years.
model AuditLog {
  id         Int      @id @default(autoincrement())
  /// Null for system actions (CLI, seed).
  actorId    Int?     @map("actor_id")
  /// e.g. "user.create", "user.permissions", "auth.login", "auth.2fa_reset"
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Server-side cart (decision 68), identified by the httpOnly `hg_cart` cookie. Only the token's SHA-256 is stored.
/// Carts unused for 30 days are deleted (on access and by the daily cleanup in the cart module).
model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  /// Entered coupon code (Phase 4d).
  couponCode String?  @map("coupon_code")
  /// The signed-in customer's cart (Phase 5c, spec §6.4); null for a guest cart.
  customerId String?  @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  items    CartItem[]
  orders   Order[]
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@index([customerId])
  @@map("carts")
}

/// One line per variant. Prices are always recomputed by the server; unitPriceAtAdd only detects a change.
model CartItem {
  cartId         String   @map("cart_id") @db.Uuid
  variantId      Int      @map("variant_id")
  quantity       Int
  addedAt        DateTime @default(now()) @map("added_at")
  /// Agorot, the variant price when the line was added.
  unitPriceAtAdd Int      @map("unit_price_at_add")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

/// Israeli localities (CBS list), reference data also used in production. `id` is the CBS locality code.
model Locality {
  id     Int    @id
  nameHe String @map("name_he")

  zone      ZoneLocality?
  addresses CustomerAddress[]

  @@index([nameHe])
  @@map("localities")
}

/// Shipping price list (spec §4.1, SHP-01): one row per top-level category, plus the default row
/// (`categoryId` null) for categories without one. Amounts in agorot. Exactly one default row is enforced by a
/// partial unique index (migration shipping_single_default_rate).
model ShippingRate {
  id            Int  @id @default(autoincrement())
  categoryId    Int? @unique @map("category_id")
  deliveryPrice Int  @map("delivery_price")
  assemblyPrice Int  @map("assembly_price")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}

/// The one row of shipping settings (id 1). Amounts in agorot.
model ShippingSettings {
  id                    Int @id @default(1)
  /// Percent of its delivery price every unit after the most expensive one pays.
  additionalItemPercent Int @default(50) @map("additional_item_percent")
  /// Per floor at and above `floorSurchargeFrom` without an elevator (full service only).
  floorSurcharge        Int @map("floor_surcharge")
  floorSurchargeFrom    Int @default(2) @map("floor_surcharge_from")

  @@map("shipping_settings")
}

/// Remote zone (SHP-03): its surcharge is added once per order, to both methods.
model ShippingZone {
  id        Int    @id @default(autoincrement())
  name      String
  /// Agorot.
  surcharge Int

  localities ZoneLocality[]

  @@map("shipping_zones")
}

/// A locality belongs to at most one zone.
model ZoneLocality {
  zoneId     Int @map("zone_id")
  localityId Int @unique @map("locality_id")

  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  locality Locality     @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@id([zoneId, localityId])
  @@map("zone_localities")
}

/// Order status (spec §5.2). A pending order past `reservedUntil` reads as expired (and is written so on its next update).
enum OrderStatus {
  PENDING_PAYMENT    @map("pending_payment")
  PAID               @map("paid")
  PAYMENT_FAILED     @map("payment_failed")
  EXPIRED            @map("expired")
  /// Phase 5 lifecycle (decision 75): paid → processing → delivery_scheduled → shipped → delivered, or cancelled.
  PROCESSING         @map("processing")
  DELIVERY_SCHEDULED @map("delivery_scheduled")
  SHIPPED            @map("shipped")
  DELIVERED          @map("delivered")
  CANCELLED          @map("cancelled")

  @@map("order_status")
}

enum OrderChannel {
  WEB   @map("web")
  /// Seller-assisted orders (Phase 6).
  STORE @map("store")

  @@map("order_channel")
}

enum OrderActorType {
  ADMIN    @map("admin")
  CUSTOMER @map("customer")
  SYSTEM   @map("system")

  @@map("order_actor_type")
}

enum RefundStatus {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("refund_status")
}

enum DeliverySlotState {
  PROPOSED         @map("proposed")
  CONFIRMED        @map("confirmed")
  CHANGE_REQUESTED @map("change_requested")
  SUPERSEDED       @map("superseded")

  @@map("delivery_slot_state")
}

/// Shipping method of an order (spec §4.1).
enum OrderShippingMethod {
  CURBSIDE     @map("curbside")
  FULL_SERVICE @map("full_service")

  @@map("order_shipping_method")
}

/// Order (spec §5.2, decision 69). Contact, address, lines and prices are a snapshot taken at checkout; money in agorot.
/// While `PENDING_PAYMENT` and before `reservedUntil` its items hold stock (cart/available-stock.ts).
model Order {
  id                 String              @id @default(uuid()) @db.Uuid
  /// Public order number; the sequence starts at 100001 (migration orders).
  number             Int                 @unique @default(autoincrement())
  /// Random token of the confirmation URL (/order/:number?t=).
  publicToken        String              @unique @map("public_token")
  status             OrderStatus         @default(PENDING_PAYMENT)
  /// { fullName, phone, email }.
  contact            Json
  /// { localityId, localityNameHe, street, houseNumber, apartment, floor, hasElevator, notes }.
  address            Json
  method             OrderShippingMethod
  shippingTotal      Int                 @map("shipping_total")
  /// The quote's breakdown for the chosen method: [{ labelHe, amount }].
  shippingLines      Json                @map("shipping_lines")
  subtotal           Int
  /// The one discount of the order (decision 70), agorot.
  discount           Int                 @default(0)
  /// Snapshot of the applied promotion: { name, kind, code, labelHe, source }; null without a discount.
  discountInfo       Json?               @map("discount_info")
  /// The applied promotion: its usage count goes up when the order is paid (spec §6). A promotion with orders
  /// cannot be deleted (RESTRICT).
  promotionId        Int?                @map("promotion_id")
  total              Int
  /// { fulfillment, leadTimeDays } of the slowest line (CRT-04).
  deliveryEstimate   Json                @map("delivery_estimate")
  /// Codes of the providers that handle this order (CLAUDE.md §4.2).
  paymentProvider    String              @map("payment_provider")
  shippingProvider   String              @map("shipping_provider")
  /// The cart the order came from: its lines are removed when the order is paid.
  cartId             String?             @map("cart_id") @db.Uuid
  reservedUntil      DateTime            @map("reserved_until")
  /// Paid while an in-stock line no longer had enough stock (a late payment after its reservation expired):
  /// stock was floored at 0 and staff must sort it out.
  stockShortage      Boolean             @default(false) @map("stock_shortage")
  channel            OrderChannel        @default(WEB)
  /// Agorot refunded so far; CHECK refunded_total BETWEEN 0 AND total (migration order_lifecycle).
  refundedTotal      Int                 @default(0) @map("refunded_total")
  deliveredAt        DateTime?           @map("delivered_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  /// Staff must look at it for a reason outside the Phase 4 flags (failed refund, late payment on a cancelled order…).
  needsAttention     Boolean             @default(false) @map("needs_attention")
  attentionNote      String?             @map("attention_note")
  /// The account that placed the order (Phase 5c); null for a guest order, which is never linked (decision 77).
  customerId         String?             @map("customer_id") @db.Uuid
  /// The checkout's marketing checkbox (unchecked by default, CLAUDE.md §4.4), with its time; source `checkout`.
  marketingConsent   Boolean             @default(false) @map("marketing_consent")
  marketingConsentAt DateTime?           @map("marketing_consent_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  cart          Cart?              @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promotion     Promotion?         @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
  events        OrderStatusEvent[]
  refunds       Refund[]
  slots         DeliverySlot[]
  jobs          OutboxJob[]
  notifications NotificationLog[]
  invoices      Invoice[]

  @@index([status, reservedUntil])
  @@index([cartId])
  @@index([createdAt])
  @@index([promotionId])
  @@index([customerId])
  @@map("orders")
}

/// One order line: a snapshot of what was bought. The variant link is cleared if the variant is ever deleted.
model OrderItem {
  id           Int    @id @default(autoincrement())
  orderId      String @map("order_id") @db.Uuid
  variantId    Int?   @map("variant_id")
  sku          String
  modelName    String @map("model_name")
  nameHe       String @map("name_he")
  /// Hebrew option labels in axis order.
  optionLabels Json   @map("option_labels")
  /// Agorot, VAT included: the price actually charged.
  unitPrice    Int    @map("unit_price")
  quantity     Int
  lineTotal    Int    @map("line_total")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// One status move of an order (spec §3, §4.1).
model OrderStatusEvent {
  id           Int            @id @default(autoincrement())
  orderId      String         @map("order_id") @db.Uuid
  fromStatus   OrderStatus?   @map("from_status")
  toStatus     OrderStatus    @map("to_status")
  actorType    OrderActorType @map("actor_type")
  actorAdminId Int?           @map("actor_admin_id")
  note         String?
  createdAt    DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

/// A refund through PaymentProvider.refund (spec §4.3). `refundedTotal` of the order grows only on SUCCEEDED.
model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  /// Agorot.
  amount           Int
  reason           String
  adminUserId      Int?         @map("admin_user_id")
  /// Code of the provider that handled it.
  provider         String
  providerRefundId String?      @map("provider_refund_id")
  status           RefundStatus @default(PENDING)
  idempotencyKey   String       @unique @map("idempotency_key")
  error            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNote Invoice?

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

/// An agreed delivery date and window (spec §3); one non-superseded slot per order, enforced by a partial unique
/// index (migration order_lifecycle). The link token is stored hashed.
model DeliverySlot {
  id          Int               @id @default(autoincrement())
  orderId     String            @map("order_id") @db.Uuid
  date        DateTime          @db.Date
  /// Local times, 'HH:MM'.
  windowFrom  String            @map("window_from")
  windowTo    String            @map("window_to")
  tokenHash   String?           @unique @map("token_hash")
  state       DeliverySlotState @default(PROPOSED)
  note        String?
  respondedAt DateTime?         @map("responded_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("delivery_slots")
}

enum PaymentStatus {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("payment_status")
}

/// One payment attempt (spec §5.3). Never card data (NFR-10): only the provider's transaction id, status and amount.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  /// Code of the provider that handled it.
  provider      String
  transactionId String        @unique @map("transaction_id")
  status        PaymentStatus @default(PENDING)
  installments  Int?
  /// Agorot: the amount asked for (the order total).
  amount        Int
  /// The provider's own status, or a flag such as `amount_mismatch`.
  rawStatus     String?       @map("raw_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

// ---------- Outbox (Phase 5b, spec §5.1, decision 83) ----------

enum OutboxJobState {
  PENDING @map("pending")
  RUNNING @map("running")
  DONE    @map("done")
  FAILED  @map("failed")

  @@map("outbox_job_state")
}

/// A side effect (e-mail, SMS, invoice, refund) written in the transaction of the change that causes it and run by
/// the API's worker (apps/api/src/outbox/). `dedupeKey` makes enqueueing idempotent; a failure retries with backoff,
/// after 8 attempts the job is FAILED (admin "משימות שנכשלו", and the order needs attention).
model OutboxJob {
  id        String         @id @default(uuid()) @db.Uuid
  /// `OutboxJobType` of @hg/models (`email.order_paid`, `invoice.issue`…).
  type      String
  dedupeKey String         @unique @map("dedupe_key")
  payload   Json
  state     OutboxJobState @default(PENDING)
  attempts  Int            @default(0)
  runAfter  DateTime       @default(now()) @map("run_after")
  lastError String?        @map("last_error")
  /// The order the job belongs to (its failed jobs flag it); null for jobs of no order.
  orderId   String?        @map("order_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")
  /// Also the claim time of a RUNNING job (a RUNNING job older than 10 minutes is reclaimed).
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([state, runAfter])
  @@index([orderId])
  @@map("outbox_jobs")
}

// ---------- Promotions and coupons (Phase 4d, spec §6, decision 70) ----------

enum PromotionKind {
  AUTOMATIC @map("automatic")
  COUPON    @map("coupon")

  @@map("promotion_kind")
}

enum DiscountType {
  PERCENT @map("percent")
  FIXED   @map("fixed")

  @@map("promotion_discount_type")
}

enum PromotionTarget {
  ORDER      @map("order")
  CATEGORIES @map("categories")
  PRODUCTS   @map("products")

  @@map("promotion_target")
}

/// A promotion: automatic, or a coupon the customer enters. One discount per order — the larger wins (spec §6).
/// CHECK constraints (raw SQL, migration promotions_checks): code upper-case; a code exactly for coupons; value > 0;
/// percent value ≤ 100.
model Promotion {
  id           Int             @id @default(autoincrement())
  name         String
  kind         PromotionKind
  /// Coupons only: unique, stored upper-case (entered case-insensitively).
  code         String?         @unique
  discountType DiscountType    @map("discount_type")
  /// Percent 1–100, or agorot for a fixed discount.
  value        Int
  target       PromotionTarget
  /// Category ids (sub-categories included) or product ids, by target; empty for the whole order.
  targetIds    Int[]           @default([]) @map("target_ids")
  /// Agorot, on the subtotal of the eligible lines.
  minSubtotal  Int             @default(0) @map("min_subtotal")
  startsAt     DateTime?       @map("starts_at")
  endsAt       DateTime?       @map("ends_at")
  /// Paid orders allowed (coupons); null = no limit.
  usageLimit   Int?            @map("usage_limit")
  /// Paid orders that used it (spec §5.4); may pass the limit when a pending order is paid late.
  usedCount    Int             @default(0) @map("used_count")
  active       Boolean         @default(true)
  /// "הטבת הצטרפות" (decision 79): automatic only, applied to the first paid order of each account. At most one
  /// active welcome promotion (partial unique index, migration welcome_promotion).
  isWelcome    Boolean         @default(false) @map("is_welcome")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  orders Order[]

  @@index([kind, active])
  @@map("promotions")
}

// ---------- Notifications (Phase 5b, spec §3, §5.2) ----------

enum NotificationChannel {
  EMAIL @map("email")
  SMS   @map("sms")

  @@map("notification_channel")
}

enum NotificationStatus {
  SENT   @map("sent")
  FAILED @map("failed")

  @@map("notification_status")
}

/// One message sent (or refused) through the NotificationProvider. The recipient is stored masked; `subject` and the
/// rendered `body` (HTML for an e-mail, text for an SMS) only when the provider is `mock` (the dev viewer).
model NotificationLog {
  id                String              @id @default(uuid()) @db.Uuid
  channel           NotificationChannel
  recipientMasked   String              @map("recipient_masked")
  template          String
  /// Code of the provider that handled it.
  provider          String
  providerMessageId String?             @map("provider_message_id")
  status            NotificationStatus
  orderId           String?             @map("order_id") @db.Uuid
  subject           String?
  body              String?
  createdAt         DateTime            @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([orderId])
  @@map("notification_log")
}

// ---------- Invoices (Phase 5b, spec §3, §5.4, CHK-08, decision 81) ----------

enum InvoiceType {
  TAX_INVOICE_RECEIPT @map("tax_invoice_receipt")
  CREDIT_NOTE         @map("credit_note")

  @@map("invoice_type")
}

/// A tax document issued through the InvoiceProvider by an outbox job: a tax invoice / receipt when an order is paid,
/// a credit note per succeeded refund. `idempotencyKey` is the job's dedupe key (unique), so a repeated job never
/// issues twice. Amounts in agorot; the VAT is computed once at issue time and never recomputed. CHECKs (migration
/// invoices): amount > 0, vat_amount >= 0, a refund exactly for credit notes, one tax invoice per order. A tax document
/// is never deleted with its order or refund: both relations RESTRICT (migration invoices_restrict).
model Invoice {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  type           InvoiceType
  /// Credit notes only: the refund it credits.
  refundId       String?     @unique @map("refund_id") @db.Uuid
  /// Code of the provider that issued it.
  provider       String
  /// The provider's document number.
  number         String
  /// The provider's own link to the document, when it hosts it.
  documentUrl    String?     @map("document_url")
  /// Key of the document in the private storage area (`invoices/<number>.html`), when we keep the file.
  fileKey        String?     @map("file_key")
  /// Agorot, VAT included (the order total, or the refund amount).
  amount         Int
  vatAmount      Int         @map("vat_amount")
  vatRate        Decimal     @map("vat_rate") @db.Decimal(5, 4)
  issuedAt       DateTime    @map("issued_at")
  idempotencyKey String      @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([provider, number])
  @@index([orderId])
  @@index([issuedAt])
  @@map("invoices")
}

/// The Israeli VAT rate from a date on (spec §3, §5.4). An invoice takes the latest rate whose `effectiveFrom` is on or
/// before its Israel issue date. Seeded by migration invoices with 18% from 2025-01-01.
model VatRate {
  id            Int      @id @default(autoincrement())
  rate          Decimal  @db.Decimal(5, 4)
  effectiveFrom DateTime @unique @map("effective_from") @db.Date

  @@map("vat_rates")
}

/// The `mock` invoice adapter's own record (development and tests): the number it gave each idempotency key (and the
/// document date it was asked for), so the same key always gets the same number, as a real provider would. Numbers come from the sequences
/// `mock_invoice_seq` / `mock_credit_note_seq` (migration invoices).
model MockInvoiceDocument {
  idempotencyKey String      @id @map("idempotency_key")
  type           InvoiceType
  number         String      @unique
  issuedAt       DateTime    @default(now()) @map("issued_at")

  @@map("mock_invoice_documents")
}

// ---------- Customer accounts (Phase 5c, spec §3, §6.1, §6.2, ACC-01, NFR-12, decision 80) ----------

enum MarketingConsentSource {
  SIGNUP   @map("signup")
  CHECKOUT @map("checkout")
  ACCOUNT  @map("account")

  @@map("marketing_consent_source")
}

/// A storefront customer. Phone (05XXXXXXXX) and e-mail (lower-case) are stored normalized and are unique; each counts
/// as verified only after a code sent to it was entered (decision 80). The password is optional (argon2).
model Customer {
  id                     String                  @id @default(uuid()) @db.Uuid
  fullName               String                  @map("full_name")
  phone                  String                  @unique
  email                  String                  @unique
  phoneVerifiedAt        DateTime?               @map("phone_verified_at")
  emailVerifiedAt        DateTime?               @map("email_verified_at")
  passwordHash           String?                 @map("password_hash")
  marketingConsent       Boolean                 @default(false) @map("marketing_consent")
  marketingConsentAt     DateTime?               @map("marketing_consent_at")
  marketingConsentSource MarketingConsentSource? @map("marketing_consent_source")
  marketingWithdrawnAt   DateTime?               @map("marketing_withdrawn_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  addresses CustomerAddress[]
  sessions  CustomerSession[]
  otpCodes  OtpCode[]
  orders    Order[]
  carts     Cart[]

  @@map("customers")
}

/// A saved delivery address: the same fields as the order address snapshot.
model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  localityId  Int      @map("locality_id")
  street      String
  houseNumber String   @map("house_number")
  apartment   String?
  floor       Int
  hasElevator Boolean  @map("has_elevator")
  notes       String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  locality Locality @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_addresses")
}

/// A signed-in browser (cookie hg_customer): only the SHA-256 of the random token is stored. 30 days, renewed on use
/// at most once a day; sign-out deletes the row.
model CustomerSession {
  id         Int      @id @default(autoincrement())
  customerId String   @map("customer_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

enum OtpPurpose {
  SIGN_IN        @map("sign_in")
  SIGN_UP        @map("sign_up")
  VERIFY_CONTACT @map("verify_contact")
  RESET_PASSWORD @map("reset_password")

  @@map("otp_purpose")
}

/// A one-time code (spec §6.2): 6 digits, 10 minutes, at most 5 attempts; only an HMAC of code + target + purpose is
/// stored. Only the newest code of a target and purpose can be used. A sign-in code for a phone or e-mail without an
/// account leaves a sign-up ticket on its row: `signUpTokenHash` (SHA-256 of the token given to the browser), valid
/// until `signUpExpiresAt` (30 minutes), cleared when used. `customerId` is set on codes that confirm a new phone or
/// e-mail of a signed-in customer (the new value is the target).
model OtpCode {
  id              Int                 @id @default(autoincrement())
  target          String
  channel         NotificationChannel
  purpose         OtpPurpose
  codeHash        String              @map("code_hash")
  expiresAt       DateTime            @map("expires_at")
  attempts        Int                 @default(0)
  consumedAt      DateTime?           @map("consumed_at")
  customerId      String?             @map("customer_id") @db.Uuid
  signUpTokenHash String?             @unique @map("sign_up_token_hash")
  signUpExpiresAt DateTime?           @map("sign_up_expires_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([target, createdAt])
  @@index([customerId])
  @@map("otp_codes")
}
