# Production Caddyfile (spec 9b.2). Two hosts:
#   {$SITE_HOST}  - the storefront: /api -> api:3000, /media -> the public S3 bucket, the rest -> web:4000
#   {$ADMIN_HOST} - the admin: /api -> api:3000, /media -> the public S3 bucket, the rest -> /srv/admin
# Env: SITE_HOST, ADMIN_HOST, S3_PUBLIC_BUCKET, S3_PUBLIC_UPSTREAM (path-style S3 endpoint),
# CADDY_GLOBAL_OPTIONS (the rehearsal sets local_certs), CF_TRUSTED_RANGES (space-separated CIDRs: Cloudflare's
# ranges from deploy/cloudflare-ips.txt; the rehearsal sets a range that trusts nothing real),
# CADDY_ENV (production | staging | rehearsal -> env-<name>.caddy), CADDY_TLS (origin | auto -> tls-<name>.caddy),
# STAGING_AUTH_USER / STAGING_AUTH_HASH (staging gate only, a bcrypt hash from `caddy hash-password`).
# The snippets admin_headers and webhook_limits come from admin-headers.caddy and api-limits.caddy.
{
	# rate_limit comes from the caddy-ratelimit plugin and has no default position.
	order rate_limit before basic_auth

	# Behind Cloudflare (decision 106): the client IP is CF-Connecting-IP, but only when the connection comes
	# from one of Cloudflare's ranges. From any other source the header is ignored and the peer address is the
	# client, so nobody can pick their own IP (throttles, logs) by sending the header. {client_ip} below is the
	# result; it goes to the upstreams as X-Forwarded-For and keys the webhook rate limit.
	servers {
		trusted_proxies static {$CF_TRUSTED_RANGES}
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}

	# Every non-access log (errors such as "upstream down", TLS, startup) goes through the same filter
	# as the access log: the http.log.error entries carry the request, and its query (?t=, ?preview=),
	# Referer, Cookie and Authorization must never be printed. The error message itself stays, so a
	# dead upstream is still visible ("dial tcp: lookup web ...", status 502, path without the query).
	# uri: the rewrite handler's own (debug) entries print the rewritten URI next to the request.
	log default {
		output stderr
		format filter {
			uri regexp \?.* ""
			request>uri regexp \?.* ""
			request>headers>Referer delete
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}

	{$CADDY_GLOBAL_OPTIONS}
}

# Only the two snippet files: env-*.caddy and tls-*.caddy hold plain directives and are imported inside
# the site blocks below, never at the top level.
import admin-headers.caddy
import api-limits.caddy

# Compression, HSTS (includeSubDomains, no preload), no Server header, and an access log without query
# strings (tokens, preview links) or credentials.
(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format filter {
			request>uri regexp \?.* ""
			request>headers>Referer delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
			error_message regexp \?\S* ""
		}
	}

	# Keep this block. Caddy's own error answers (502 while an upstream is down, a missing file, a
	# handler error) do not run the deferred header block above, so without it they would go out with
	# "Server: Caddy" and without HSTS. The body stays empty.
	# Because handle_errors handles the error, Caddy logs the error itself only at debug level; the
	# access line keeps it visible instead (status 502 plus e.g. "dial tcp: lookup web ... no such
	# host"), with any query cut off by the filter above.
	handle_errors {
		log_append error_message {err.message}
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			-Server
		}
	}
}

# Routes that must never be reachable from the internet (the API guards them too).
(blocked) {
	@blocked path /api/internal /api/internal/* /api/admin/dev /api/admin/dev/*
	handle @blocked {
		respond 404
	}
}

# Product and content photos: /media/<key> -> <upstream>/<public bucket>/<key>.
# Only GET / HEAD, only plain keys (no percent escapes, backslashes, "..", "//"), no query string and
# no client credentials reach S3, so Caddy can never be used to read another bucket or as an S3 proxy.
(media) {
	handle /media/* {
		route {
			@media_unsafe expression `!{http.request.orig_uri}.matches("^/media/[A-Za-z0-9_-][A-Za-z0-9._/-]*(\\?.*)?$") || {http.request.orig_uri.path}.contains("..") || {http.request.orig_uri.path}.contains("//")`
			respond @media_unsafe 404

			@media_method not method GET HEAD
			header @media_method Allow "GET, HEAD"
			respond @media_method 405

			uri strip_prefix /media
			rewrite * /{$S3_PUBLIC_BUCKET}{path}?

			# Deferred, so they replace whatever S3 sends instead of adding a second value.
			header {
				X-Content-Type-Options nosniff
				defer
			}
			header {
				Cache-Control "public, max-age=31536000, immutable"
				match {
					status 200 206 304
				}
			}

			reverse_proxy {$S3_PUBLIC_UPSTREAM} {
				header_up Host {upstream_hostport}
				header_up -Authorization
				header_up -Cookie
				# No visitor IP to the object store.
				header_up -X-Forwarded-For
				header_up -CF-Connecting-IP
				header_down -X-Amz-*
				header_down -X-Ratelimit-*
				header_down -X-Xss-Protection
				header_down -Cache-Control
			}
		}
	}
}

{$SITE_HOST} {
	# The environment (staging gate, noindex) and the TLS source. An empty or missing CADDY_ENV / CADDY_TLS
	# names a file that does not exist (env-.caddy), and Caddy refuses to start.
	import env-{$CADDY_ENV}.caddy
	import tls-{$CADDY_TLS}.caddy
	import common
	import blocked
	import webhook_limits
	import media

	# Body limits from the API's own (plus margin): damaged-product photos are up to 5 x 10 MiB in one form
	# (52 428 800 bytes plus multipart overhead; Caddy's MB is 1000 x 1000 bytes, so 55MB), every other
	# request is JSON. The two matchers never overlap, because nested request_body limits do not replace
	# each other: the smaller one always wins. They match the raw request URI, not the cleaned path, so an
	# encoded path that only cleans to the damaged route (/x/..%2fapi/support/damaged) keeps 1MB.
	# The webhooks keep their 64KB (webhook_limits).
	@damaged expression `{http.request.orig_uri}.matches("^/api/support/damaged(\\?.*)?$")`
	@not_damaged not expression `{http.request.orig_uri}.matches("^/api/support/damaged(\\?.*)?$")`
	request_body @damaged {
		max_size 55MB
	}
	request_body @not_damaged {
		max_size 1MB
	}

	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Host {host}
			header_up -CF-Connecting-IP
		}
	}

	# The storefront sets its own security headers and CSP (per-request nonce).
	handle {
		reverse_proxy web:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Host {host}
			header_up -CF-Connecting-IP
		}
	}
}

{$ADMIN_HOST} {
	# The environment (staging gate, noindex) and the TLS source. An empty or missing CADDY_ENV / CADDY_TLS
	# names a file that does not exist (env-.caddy), and Caddy refuses to start.
	import env-{$CADDY_ENV}.caddy
	import tls-{$CADDY_TLS}.caddy
	import common
	import blocked
	import admin_headers
	import media

	# Product and content photos are up to 15 MB (IMAGE_UPLOAD / CONTENT_IMAGE.maxBytes), Excel 5 MB.
	request_body {
		max_size 16MB
	}

	# The signed webhooks live only on the site host.
	@webhooks path /api/payments/webhook /api/marketing/webhook
	handle @webhooks {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Host {host}
			header_up -CF-Connecting-IP
		}
	}

	handle {
		root * /srv/admin

		# Content-hashed build files never change: cache them for a year. A missing one is a 404, never index.html.
		@hashed path_regexp ^/(static-media/[^/]+|[a-z]+-[A-Za-z0-9_-]{8}\.(js|css))$
		handle @hashed {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				match {
					status 200 304
				}
			}
			file_server
		}

		# index.html and the app routes it serves: always revalidate, so a deploy shows up at once.
		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
