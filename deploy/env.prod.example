# Names of the production / staging env file read by docker-compose.prod.yml (--env-file). NO VALUES in the repo:
# copy this file outside the repo, fill it on the server, chmod 600. Each secret is generated on its own:
#   secret (48 chars):  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
#   key (32 bytes):     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Compose passes each service only what it reads (see the service's `environment:`). The rehearsal file is generated by
# deploy/rehearsal/make-env.mjs. Details of each variable: .env.example and dev/CLAUDE.md §6.

# --- Images ---
# The tag of nesto-app / nesto-caddy / nesto-backup to run (deploy.sh sets it; never `latest`).
IMAGE_TAG=

# --- postgres (first volume init only: deploy/postgres/init/01-roles.sh) ---
# Cluster superuser `postgres`: init and restore only, never given to the app.
POSTGRES_PASSWORD=
# Password of nesto_owner (owns the tables; migrate only).
NESTO_OWNER_PASSWORD=
# Password of nesto_app (the API).
NESTO_APP_PASSWORD=
# Password of nesto_backup (the backup job, read-only except backup_runs).
NESTO_BACKUP_PASSWORD=

# --- migrate ---
# postgresql://nesto_owner:<NESTO_OWNER_PASSWORD>@postgres:5432/nesto
MIGRATE_DATABASE_URL=
# Role names granted by apply-db-grants (optional; defaults nesto_app / nesto_backup).
DB_APP_ROLE=
DB_BACKUP_ROLE=

# --- api ---
# production (default) or staging (mock providers and the payment sandbox allowed).
APP_ENV=
# postgresql://nesto_app:<NESTO_APP_PASSWORD>@postgres:5432/nesto
DATABASE_URL=
# The edge network: 172.31.240.0/24 (Caddy's only network).
TRUST_PROXY=
# https origin of the storefront (also read by web).
SITE_URL=
# https origin of the storefront (allowed Origin of public writes).
STOREFRONT_URL=
# https origin of the admin.
ADMIN_URL=
# 32 bytes, base64: encrypts 2FA secrets.
TOTP_ENCRYPTION_KEY=
# 32 bytes, base64: encrypts order link tokens.
ORDER_TOKEN_KEY=
# Secret (48 chars): HMAC of one-time codes.
OTP_PEPPER=
# Secret (48 chars): HMAC of unsubscribe links.
MARKETING_TOKEN_SECRET=
# Secret (48 chars): HMAC of landing-page preview links.
CONTENT_PREVIEW_SECRET=
# Secret (48 chars), the same in api and web: storefront render errors to the API.
INTERNAL_API_TOKEN=
# s3 (required in production).
STORAGE_PROVIDER=
# https S3 endpoint of the media buckets (also read by backup).
S3_ENDPOINT=
# S3 region (also read by backup).
S3_REGION=
# The API's media keys (read / write on both media buckets).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public photo bucket (also read by caddy and backup).
S3_PUBLIC_BUCKET=
# Private bucket: originals, support photos, invoices (also read by backup).
S3_PRIVATE_BUCKET=
# true (default, path style) or false (optional).
S3_FORCE_PATH_STYLE=
# Provider adapters (sandbox / mock only with APP_ENV=staging).
PAYMENT_PROVIDER=
SHIPPING_PROVIDER=
EMAIL_PROVIDER=
SMS_PROVIDER=
INVOICE_PROVIDER=
MARKETING_PROVIDER=
# Sandbox / mock webhook signing secrets (optional, staging only).
PAYMENT_SANDBOX_SECRET=
# true only on a staging server with a public address (the sandbox refuses public sites otherwise); never production.
PAYMENT_SANDBOX_ALLOW_REMOTE=
MARKETING_MOCK_SECRET=
# Sender of every e-mail.
EMAIL_FROM=
# Support inbox address.
SUPPORT_EMAIL=
# Alert e-mails (set at runtime only; empty = no alerts).
ALERT_EMAIL=
# true where the backup service runs: a missing DB backup for 26 h raises an alert.
BACKUP_EXPECTED=

# --- web (storefront SSR; also SITE_URL and INTERNAL_API_TOKEN above) ---
# Host names the SSR accepts, comma-separated; the first one is used by the health check.
NG_ALLOWED_HOSTS=
# enforce (default) or report-only.
STOREFRONT_CSP=
# true on production only (never staging).
SEO_INDEXING=

# --- caddy (also S3_PUBLIC_BUCKET above) ---
# Storefront host name (no scheme).
SITE_HOST=
# Admin host name (no scheme).
ADMIN_HOST=
# Path-style S3 origin Caddy proxies /media to (no bucket, no path).
S3_PUBLIC_UPSTREAM=
# Extra Caddy global options (9c: ACME / Cloudflare; may be empty).
CADDY_GLOBAL_OPTIONS=

# --- backup (also S3_ENDPOINT, S3_REGION, S3_PUBLIC_BUCKET, S3_PRIVATE_BUCKET, S3_FORCE_PATH_STYLE above) ---
# postgresql://nesto_backup:<NESTO_BACKUP_PASSWORD>@postgres:5432/nesto
BACKUP_DATABASE_URL=
# The age public key (age1...); the private key stays offline with the owner.
BACKUP_AGE_RECIPIENT=
# Daily run time, Israel time (optional, default 02:30).
BACKUP_AT=
# The backup bucket's S3 endpoint, region and name.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
# Write-only keys on the backup bucket (plus read on the media buckets).
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- restore (ONE-OFF, NEVER IN THE SERVER ENV FILE) ---
# Given only on the command line of a one-off `docker run` / `docker compose run` of the backup image, at restore
# time, and gone afterwards (deploy/backup/README.md). They are commented out here so they are never filled in above.
# A cluster role that may CREATE / DROP databases (the `postgres` superuser): restore-db.
# RESTORE_ADMIN_DATABASE_URL=
# Where restore-db writes its `restore_test` row (optional): the app database as nesto_backup.
# RESTORE_RECORD_DATABASE_URL=
# backup-reader keys (read + list the backup bucket): restore-db and restore-media.
# BACKUP_READ_ACCESS_KEY_ID=
# BACKUP_READ_SECRET_ACCESS_KEY=
# The app user's media keys (write the media buckets): restore-media.
# RESTORE_S3_ACCESS_KEY_ID=
# RESTORE_S3_SECRET_ACCESS_KEY=
