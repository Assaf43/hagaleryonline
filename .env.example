# Copy to .env and adjust. Never commit .env.
# Secrets for providers (payments, SMS, email, invoicing, marketing) are added here
# as each adapter is built — never stored in the database.

# --- Database (docker-compose.yml) ---
POSTGRES_DB=hagalery
POSTGRES_USER=hagalery
POSTGRES_PASSWORD=hagalery_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hagalery:hagalery_dev@localhost:5432/hagalery

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- Storefront SSR server (production build only) ---
PORT=4000

# --- Admin authentication (Phase 2a) ---
# Where the admin app runs; used in invite / password-reset links and as the allowed Origin.
ADMIN_URL=http://localhost:4300
# Where the storefront runs: the only Origin allowed to send public writes (cart) to the API.
STOREFRONT_URL=http://localhost:4200
# 32 random bytes, base64. Encrypts 2FA secrets. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# true behind HTTPS (staging/production): cookies get the Secure flag.
COOKIE_SECURE=false
# Password/code attempts per IP per 15 minutes (default 30).
# AUTH_IP_ATTEMPT_LIMIT=30

# --- Product photos (Phase 2d) ---
# Local-disk storage: public copies in <MEDIA_DIR>/public (served at MEDIA_URL), originals in
# <MEDIA_DIR>/private (never served). Relative to apps/api; the default is storage/ at the repo root.
# MEDIA_DIR=../../storage
# MEDIA_URL=/media

# --- Storefront SSR (Phase 3) ---
# Where the server render calls the API, and the public site address for canonical links.
# The API also uses SITE_URL (else STOREFRONT_URL) for links in e-mails and SMS: required in production (the API
# refuses to start without one of them; dev falls back to http://localhost:4200), an absolute http(s) URL.
# API_URL=http://localhost:3000
# SITE_URL=https://hagaleryonline.co.il
# Search engine indexing (NFR-06): the storefront server does not read this file. Set SEO_INDEXING in the
# storefront server's process/container environment: true on production only (never staging). Off:
# robots.txt disallows everything and every page gets noindex.
SEO_INDEXING=false

# --- Shipping (Phase 4b) ---
# Active ShippingProvider adapter. Only `manual` exists (admin price list, manual coordination); an unknown
# value stops the API at startup.
SHIPPING_PROVIDER=manual

# --- Payments (Phase 4c) ---
# Active PaymentProvider adapter — required (no default: a missing or unknown value stops the API at startup).
# Only `sandbox` exists: development only, no real money, and anyone can mark its payments paid. It refuses to start
# when NODE_ENV=production, and on a public SITE_URL / STOREFRONT_URL (anything but localhost, 127.0.0.1, [::1],
# *.localhost, *.test) unless a test environment sets PAYMENT_SANDBOX_ALLOW_REMOTE=true.
PAYMENT_PROVIDER=sandbox
# PAYMENT_SANDBOX_ALLOW_REMOTE=true
# Signs the sandbox webhooks (HMAC-SHA256). Any random value; generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty: a random secret per API process is used (webhooks signed before a restart then fail).
PAYMENT_SANDBOX_SECRET=
# e2e only: makes every sandbox refund fail (read at each refund call), to test the failed-refund flow.
# PAYMENT_SANDBOX_FAIL_REFUNDS=true
# Where the API reaches itself: the sandbox delivers its signed webhook to <API_INTERNAL_URL>/api/payments/webhook.
# API_INTERNAL_URL=http://localhost:3000
# The storefront address in payment-page links (/pay/sandbox/...) is SITE_URL, else STOREFRONT_URL.

# --- Notifications (Phase 5b) ---
# Active e-mail and SMS adapters — both required (no default: a missing or unknown value stops the API at startup).
# Only `mock` exists: it sends nothing, logs every message with its full body (admin page "הודעות שנשלחו (בדיקה)",
# OTP codes included) and refuses NODE_ENV=production.
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
# The sender of every e-mail (the mock only logs it).
EMAIL_FROM=NESTO <no-reply@example.test>
# Support address shown to customers (used from Phase 5d); not required at startup.
SUPPORT_EMAIL=support@example.test

# --- Invoices (Phase 5b) ---
# Active InvoiceProvider adapter — required (no default: a missing or unknown value stops the API at startup).
# Only `mock` exists: numbers MOCK-INV-000001 / MOCK-CN-000001, a simple HTML document kept in <MEDIA_DIR>/private/invoices
# (never served as media; customers open it with the order link, staff with "invoices.export"). It issues no real tax
# document and refuses NODE_ENV=production.
INVOICE_PROVIDER=mock

# Which proxy in front of the API may set the client IP (X-Forwarded-For): the per-IP limits and the audit log use
# it. Empty → loopback (dev). Production behind Caddy in Docker: its network, e.g. `loopback, 172.18.0.0/16`, or a
# hop count (`1`). Never "true" (refused): any client could then choose its own IP.
# TRUST_PROXY=loopback

# Per-IP limits (per 15 minutes) of the public writes that reserve stock, open payments, check coupon codes or
# cancel unpaid orders. Defaults: 20 / 20 / 60 / 20 / 20.
# THROTTLE_CHECKOUT_LIMIT=20
# THROTTLE_RETRY_LIMIT=20
# THROTTLE_SANDBOX_LIMIT=60
# THROTTLE_COUPON_LIMIT=20
# THROTTLE_CANCEL_LIMIT=20
# THROTTLE_DELIVERY_LIMIT=20

# --- Customer accounts (Phase 5c) ---
# HMAC key of the one-time codes (only the HMAC of code + target + purpose is stored). Required in production, at least
# 32 random characters (the API refuses to start without it); dev and tests use a fixed default when empty. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=
# Per-IP limits per 15 minutes: code requests (sign-in, sign-up, contact change, password reset) and password / code
# attempts. Defaults: 10 / 20. Each phone or e-mail also gets at most 3 codes per 10 minutes (fixed).
# THROTTLE_OTP_LIMIT=10
# THROTTLE_SIGNIN_LIMIT=20
# Per-IP limit per 15 minutes of the account's address and consent writes. Default: 60.
# THROTTLE_ACCOUNT_LIMIT=60

# --- Outbox worker (Phase 5b) ---
# E-mails, SMS, invoices and late-payment refunds are outbox jobs, run by a worker inside the API process.
# `off` disables the worker (the e2e tests run the jobs themselves); default on. Poll interval in ms (default 3000).
# OUTBOX_WORKER=off
# OUTBOX_POLL_MS=3000
