# Copy to .env and adjust. Never commit .env.
# Secrets for providers (payments, SMS, email, invoicing, marketing) are added here
# as each adapter is built — never stored in the database.
# Production (NODE_ENV=production): the API refuses to start, listing every problem by name, when a variable marked
# "required in production" is missing, a URL is not https, a secret is shorter than 32 characters, a key is not
# 32 bytes in base64, a value is a development default (or one written in this file), or two secrets are equal.
# The DATABASE_URL password must be at least 20 characters. Generate each secret / key on its own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Database (docker-compose.yml) ---
# The local Docker database (dev only). DATABASE_URL: the API's connection string, required in production.
POSTGRES_DB=hagalery
POSTGRES_USER=hagalery
POSTGRES_PASSWORD=hagalery_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hagalery:hagalery_dev@localhost:5432/hagalery

# --- API ---
# Port of the API (optional, default 3000) and the environment (`production` turns on the checks above).
API_PORT=3000
NODE_ENV=development
# Only read when NODE_ENV=production: `production` (the default) or `staging` (any other value is refused). Staging is
# the local rehearsal and the staging server: every production rule above still applies, but the mock e-mail / SMS /
# invoice / marketing providers and the payment sandbox may run (the sandbox still needs
# PAYMENT_SANDBOX_ALLOW_REMOTE=true on a public site address); a warning is logged at startup. Optional.
# APP_ENV=staging

# --- Storefront SSR server (production build only) ---
# Port of the storefront's server render (optional, not read by the API).
PORT=4000

# --- Admin authentication (Phase 2a) ---
# Where the admin app runs; used in invite / password-reset links and as the allowed Origin. Required in production
# (an https URL with no path).
ADMIN_URL=http://localhost:4300
# Where the storefront runs: the only Origin allowed to send public writes (cart) to the API. Required in production
# (an https URL with no path).
STOREFRONT_URL=http://localhost:4200
# 32 random bytes, base64. Encrypts 2FA secrets. Required (also in dev). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# --- Order links (Phase 9a) ---
# 32 random bytes, base64. Encrypts the token of each order's link (/order/<n>?t=...) in the database (AES-256-GCM).
# Required in production; dev and tests use a fixed default when empty. Changing it breaks the links already sent
# (orders sealed with the old key no longer open). Once per database, seal the tokens of older orders (their links
# keep working; safe to run again):
#   npm run admin -w @hg/api -- seal-order-tokens
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ORDER_TOKEN_KEY=
# true behind HTTPS (staging/production): cookies get the Secure flag. Optional (production cookies are Secure anyway).
COOKIE_SECURE=false
# Admin password/code attempts per IP per 15 minutes (default 30). Production keeps the default (an override is
# logged as a warning at startup).
# AUTH_IP_ATTEMPT_LIMIT=30

# --- Product photos (Phase 2d) ---
# Local-disk storage: public copies in <MEDIA_DIR>/public (served at MEDIA_URL), originals in
# <MEDIA_DIR>/private (never served). Relative to apps/api; the default is storage/ at the repo root. Optional.
# MEDIA_DIR=../../storage
# MEDIA_URL=/media
# Where photos, content images and private files are stored: `local` (the disk above, dev) or `s3` (an S3-compatible
# object store). Production requires `s3` and every S3_* value below; S3_ENDPOINT must be https, or http only with
# APP_ENV=staging and a local host (no dot or *.localhost, e.g. the rehearsal's MinIO at http://minio:9000).
STORAGE_PROVIDER=local
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=

# --- Storefront SSR (Phase 3) ---
# Where the server render calls the API, and the public site address for canonical links.
# The API also uses SITE_URL (else STOREFRONT_URL) for links in e-mails and SMS: required in production (the API
# refuses to start without one of them; dev falls back to http://localhost:4200), an absolute http(s) URL.
# SITE_URL is required in production (an https URL with no path). API_URL: optional, the storefront server only.
# API_URL=http://localhost:3000
# SITE_URL=https://hagaleryonline.co.il
# Content-Security-Policy of the storefront server: enforce | report-only | off. Default: enforce when
# NODE_ENV=production, else off. Staging may start with report-only. Storefront server only.
# STOREFRONT_CSP=enforce
# Host names the production SSR server accepts, comma-separated. Without it Angular answers 400 on every SSR
# page in production. Storefront server only.
# NG_ALLOWED_HOSTS=hagaleryonline.co.il,www.hagaleryonline.co.il
# Search engine indexing (NFR-06): the storefront server does not read this file. Set SEO_INDEXING in the
# storefront server's process/container environment: true on production only (never staging). Off:
# robots.txt disallows everything and every page gets noindex.
SEO_INDEXING=false

# --- Shipping (Phase 4b) ---
# Active ShippingProvider adapter. Only `manual` exists (admin price list, manual coordination); an unknown
# value stops the API at startup. Required in production.
SHIPPING_PROVIDER=manual

# --- Payments (Phase 4c) ---
# Active PaymentProvider adapter — required (no default: a missing or unknown value stops the API at startup).
# Only `sandbox` exists: development only, no real money, and anyone can mark its payments paid. It refuses to start
# when NODE_ENV=production (unless APP_ENV=staging), and on a public SITE_URL / STOREFRONT_URL (anything but
# localhost, 127.0.0.1, [::1], *.localhost, *.test) unless a test environment sets PAYMENT_SANDBOX_ALLOW_REMOTE=true.
PAYMENT_PROVIDER=sandbox
# Optional, test environments only.
# PAYMENT_SANDBOX_ALLOW_REMOTE=true
# Signs the sandbox webhooks (HMAC-SHA256). Optional, sandbox only. Any random value; generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty: a random secret per API process is used (webhooks signed before a restart then fail).
PAYMENT_SANDBOX_SECRET=
# e2e only: makes every sandbox refund fail (read at each refund call), to test the failed-refund flow.
# PAYMENT_SANDBOX_FAIL_REFUNDS=true
# Optional. Where the API reaches itself: the sandbox delivers its signed webhook to <API_INTERNAL_URL>/api/payments/webhook.
# API_INTERNAL_URL=http://localhost:3000
# The storefront address in payment-page links (/pay/sandbox/...) is SITE_URL, else STOREFRONT_URL.

# --- Notifications (Phase 5b) ---
# Active e-mail and SMS adapters — both required (no default: a missing or unknown value stops the API at startup).
# Only `mock` exists: it sends nothing, logs every message with its full body (admin page "הודעות שנשלחו (בדיקה)",
# OTP codes included) and refuses NODE_ENV=production (unless APP_ENV=staging).
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
# The sender of every e-mail (the mock only logs it). Required in production.
EMAIL_FROM=NESTO <no-reply@example.test>
# Support inbox: receives the new-ticket alert e-mail (Phase 5d); without it the alert is skipped with a warning.
# Required in production; optional in dev.
SUPPORT_EMAIL=support@example.test

# --- Invoices (Phase 5b) ---
# Active InvoiceProvider adapter — required (no default: a missing or unknown value stops the API at startup).
# Only `mock` exists: numbers MOCK-INV-000001 / MOCK-CN-000001, a simple HTML document kept in <MEDIA_DIR>/private/invoices
# (never served as media; customers open it with the order link, staff with "invoices.export"). It issues no real tax
# document and refuses NODE_ENV=production (unless APP_ENV=staging).
INVOICE_PROVIDER=mock

# --- E-mail marketing tool (Phase 7) ---
# Active MarketingProvider adapter — required (no default: a missing or unknown value stops the API at startup).
# Only `mock` exists: it keeps the synced list (subscribed contacts only) in the API process's memory, lost on restart,
# and refuses NODE_ENV=production (unless APP_ENV=staging). While it and both notification providers are mock, the
# admin has a dev view of the list and a dev "unsubscribe" that posts a signed webhook to
# <API_INTERNAL_URL>/api/marketing/webhook.
MARKETING_PROVIDER=mock
# Signs the mock's webhooks (HMAC-SHA256). Optional, mock only. Empty: a random secret per API process is used.
MARKETING_MOCK_SECRET=
# HMAC key of the unsubscribe links in our marketing e-mails (/newsletter/unsubscribe?t=). Required in production, at
# least 32 random characters (the API refuses to start without it); dev and tests use a fixed default when empty.
# Changing it retires the links already sent. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETING_TOKEN_SECRET=

# --- Content (Phase 8) ---
# HMAC key of the staff preview links of landing pages (/collection/<slug>?preview=<token>, 30 minutes, one page).
# Required in production, at least 32 random characters (the API refuses to start without it); dev and tests use a
# fixed default when empty. Changing it retires the preview links already handed out. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_PREVIEW_SECRET=

# Which proxy in front of the API may set the client IP (X-Forwarded-For): the per-IP limits and the audit log use
# it. Empty → loopback (dev). Production behind Caddy in Docker: its network, e.g. `loopback, 172.18.0.0/16`, or a
# hop count (`1`). Never "true" or "*" (refused), nor 0.0.0.0/0 or ::/0 (refused in production): any client could then
# choose its own IP. Required in production.
# TRUST_PROXY=loopback

# Per-IP limits (per 15 minutes) of the public writes that reserve stock, open payments, check coupon codes or
# cancel unpaid orders. Defaults: 20 / 20 / 60 / 20 / 20 / 20. Production keeps every default of THROTTLE_*_LIMIT
# (pinned by a unit test; an override is logged as a warning at startup); e2e raises them.
# THROTTLE_CHECKOUT_LIMIT=20
# THROTTLE_RETRY_LIMIT=20
# THROTTLE_SANDBOX_LIMIT=60
# THROTTLE_COUPON_LIMIT=20
# THROTTLE_CANCEL_LIMIT=20
# THROTTLE_DELIVERY_LIMIT=20

# --- Customer accounts (Phase 5c) ---
# HMAC key of the one-time codes (only the HMAC of code + target + purpose is stored). Required in production, at least
# 32 random characters (the API refuses to start without it); dev and tests use a fixed default when empty. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=
# Per-IP limits per 15 minutes: code requests (sign-in, sign-up, contact change, password reset) and password / code
# attempts. Defaults: 10 / 20. Each phone or e-mail also gets at most 3 codes per 10 minutes (fixed).
# THROTTLE_OTP_LIMIT=10
# THROTTLE_SIGNIN_LIMIT=20
# Per-IP limit per 15 minutes of the account's address and consent writes. Default: 60.
# THROTTLE_ACCOUNT_LIMIT=60
# "My order status" (/order-status): every lookup counts per IP and per order number, per 15 minutes. Defaults: 10 / 5.
# THROTTLE_LOOKUP_LIMIT=10
# THROTTLE_LOOKUP_NUMBER_LIMIT=5
# Support requests (returns, damaged products, contact): per IP, and returns / damaged products also per order number,
# per 15 minutes. Defaults: 5 / 5.
# THROTTLE_SUPPORT_LIMIT=5
# THROTTLE_SUPPORT_ORDER_LIMIT=5
# Store tablet (Phase 6): customer confirmation codes, customer lookups and code checks per seller (not per IP) per
# 15 minutes. Defaults: 30 / 60 / 60.
# THROTTLE_STORE_OTP_LIMIT=30
# THROTTLE_STORE_LOOKUP_LIMIT=60
# THROTTLE_STORE_VERIFY_LIMIT=60
# Newsletter sign-up and the confirmation link (preview + confirm) (Phase 7): per IP per 15 minutes. Default: 10.
# THROTTLE_NEWSLETTER_LIMIT=10
# The newsletter unsubscribe link: its own bucket per IP per 15 minutes. Default: 60.
# THROTTLE_NEWSLETTER_UNSUBSCRIBE_LIMIT=60

# --- Outbox worker (Phase 5b) ---
# E-mails, SMS, invoices and late-payment refunds are outbox jobs, run by a worker inside the API process.
# `off` disables the worker (the e2e tests run the jobs themselves); default on. Poll interval in ms (default 3000).
# Both optional.
# OUTBOX_WORKER=off
# OUTBOX_POLL_MS=3000

# --- Logs and error events (Phase 9b) ---
# The API logs JSON lines when NODE_ENV=production or LOG_FORMAT=json, Nest's readable format otherwise. Optional.
# LOG_FORMAT=json
# Errors and warnings are grouped in `error_events` (flushed every 5 s, groups unseen for 30 days deleted daily).
# `off` stops both timers (the e2e tests flush themselves); default on. Optional.
# ERROR_EVENTS_WORKER=off
# Alert e-mails (a new or reopened error group, a failed or missing backup) go to this address through the outbox.
# Empty = no alerts. Set it at runtime on staging / production; never commit a real address.
ALERT_EMAIL=
# `true` only where a backup container runs (rehearsal, staging, production): then "no successful database backup
# for 26 hours" raises an alert. Anything other than the exact string `true` is off.
BACKUP_EXPECTED=false
# Shared secret between the storefront server and the API: the storefront posts its render errors to
# POST /api/internal/error-events with it in the X-Internal-Token header (404 for anyone else). Set the SAME value in
# both processes. Required in production for the API (at least 32 random characters, refuses to start without it);
# empty in dev: render errors are only logged. The storefront does not refuse to start without it. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
# Reports the storefront may post per minute before the API drops the rest (default 120). Optional.
# THROTTLE_INTERNAL_ERRORS_LIMIT=120
# The running commit, shown on the admin system screen (set by the deploy; default "dev"). Optional.
# APP_VERSION=
